# Copy to .env and replace the passwords; .env is never committed.

# Host port of the API
API_PORT=8000

# PostgreSQL
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=security_assessment

# RabbitMQ
RABBITMQ_DEFAULT_USER=app
RABBITMQ_DEFAULT_PASS=change-me

# OpenAI-compatible LLM server; the default is Ollama on the Docker host
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=180
